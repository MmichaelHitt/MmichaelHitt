# ── Polymarket API credentials ─────────────────────────────────────────────
PRIVATE_KEY=0x...your_wallet_private_key...
POLY_FUNDER_ADDRESS=0x...your_funder_address...
POLY_API_KEY=your-api-key-here
POLY_SECRET=your-api-secret-here
POLY_PASSPHRASE=your-api-passphrase-here

# ── Infrastructure ──────────────────────────────────────────────────────────
PROXY_URL=http://user:pass@host:port

# ── Trading parameters (optional, defaults shown) ───────────────────────────
POSITION_USDC=2.0
SL_PRICE_CENTS=72
ASK_MIN_CENTS=80
ASK_MAX_CENTS=90
ENTRY_MIN_SEC=15
ENTRY_MAX_SEC=70
GAP_MAX_USD=3.0

# ── Mode ────────────────────────────────────────────────────────────────────
DRY_RUN=false
MARKET_SLUG_OVERRIDE=
